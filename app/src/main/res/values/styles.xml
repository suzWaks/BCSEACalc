<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="StyleLabel" parent="android:Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">56dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="StyleField" parent="android:Widget.TextView">
        <item name="android:layout_width">0dp</item>

        <item name="android:layout_marginTop">44dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:height">50dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:background">@drawable/textview_background</item>
        <item name="android:ems">4</item>
        <item name="android:maxEms">2</item>
        <item name="android:inputType">number</item>
        <item name="android:padding">8dp</item>
        <item name="paddingStart">16dp</item>
    </style>

</resources>